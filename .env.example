# Supabase — base de données et connexion.
# Valeurs disponibles dans Supabase : Project Settings > API.
# La clé "anon / publishable" est faite pour être publique (la sécurité repose sur RLS).
# Ne jamais mettre ici la clé "service_role".
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
